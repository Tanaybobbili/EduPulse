<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Interview_Date</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Interview_Date__c)),
    Interview_Date__c &lt; Application_Date__c
)</errorConditionFormula>
    <errorDisplayField>Interview_Date__c</errorDisplayField>
    <errorMessage>Interview Date cannot be earlier than Application Date.</errorMessage>
</ValidationRule>
