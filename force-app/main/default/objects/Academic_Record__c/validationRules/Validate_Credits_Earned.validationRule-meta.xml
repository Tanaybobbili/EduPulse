<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Credits_Earned</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Credits_Earned__c)),
    Credits_Earned__c &lt; 0
)</errorConditionFormula>
    <errorDisplayField>Credits_Earned__c</errorDisplayField>
    <errorMessage>Credits earned cannot be negative.</errorMessage>
</ValidationRule>
