<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Minimum_CGPA</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Minimum_CGPA__c)),
    OR(
        Minimum_CGPA__c &lt; 0,
        Minimum_CGPA__c &gt; 10
    )
)</errorConditionFormula>
    <errorDisplayField>Minimum_CGPA__c</errorDisplayField>
    <errorMessage>Minimum CGPA must be between 0 and 10.</errorMessage>
</ValidationRule>
