<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Existing_Assessment_Alert</name>
        <label>Check Existing Assessment Alert</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Assessment_Notification</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Alert_Already_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Assessment_Alert.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>END_ELEMENT_1</targetReference>
            </connector>
            <label>Alert Already Exists</label>
        </rules>
    </decisions>
    <ends>
        <name>END_ELEMENT_1</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <interviewLabel>Assessment Performance Alert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Assessment Performance Alert</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>LightningFlowBuilder</value>
    </processMetadataValues>

    <processMetadataValues>
        <name>CanvasMode</name>
        <value>AUTO_LAYOUT_CANVAS</value>
    </processMetadataValues>

    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>LightningFlowBuilder</value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Assessment_Notification</name>
        <label>Create Assessment Notification</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_1</targetReference>
        </connector>
        <inputAssignments>
            <field>Message__c</field>
            <value>
                <stringValue>Your assessment score is below 40%. Please review your performance and contact your mentor for academic support.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Notification_Type__c</field>
            <value>
                <stringValue>Assessment Alert</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Related_Record_ID__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Student__c</field>
            <value>
                <elementReference>$Record.Student__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject__c</field>
            <value>
                <stringValue>Low Assessment Score Alert</stringValue>
            </value>
        </inputAssignments>
        <object>Notification_Log__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Existing_Assessment_Alert</name>
        <label>Get Existing Assessment Alert</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Existing_Assessment_Alert</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Related_Record_ID__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Notification_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Assessment Alert</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Notification_Log__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Existing_Assessment_Alert</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Score_Percentage__c</field>
            <operator>LessThan</operator>
            <value>
                <numberValue>40.0</numberValue>
            </value>
        </filters>
        <object>Assessment__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
